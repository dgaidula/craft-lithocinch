{# Lithocinch settings (Control Panel). Most options are better set per-environment in
   config/litho.php; this covers the essentials. #}
{% import "_includes/forms" as forms %}

{{ forms.selectField({
    label: 'Backend driver',
    instructions: 'How Craft reaches the lithocinch engine.',
    id: 'driver',
    name: 'driver',
    value: settings.driver,
    options: [
        { label: 'CLI (Node on this server)', value: 'cli' },
        { label: 'Daemon (local serve)', value: 'daemon' },
        { label: 'Remote API (hosted Lambda)', value: 'remote' },
    ],
}) }}

{{ forms.autosuggestField({
    label: 'Tool path (cli)',
    instructions: 'Command or path to the `lithocinch` binary (or cli.js).',
    id: 'toolPath',
    name: 'toolPath',
    value: settings.toolPath,
    suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
    label: 'Daemon URL',
    id: 'daemonUrl',
    name: 'daemonUrl',
    value: settings.daemonUrl,
    suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
    label: 'Remote API URL',
    id: 'apiUrl',
    name: 'apiUrl',
    value: settings.apiUrl,
    suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
    label: 'API key / token',
    instructions: 'Bearer token for the daemon/remote driver. Use an env var.',
    id: 'apiKey',
    name: 'apiKey',
    value: settings.apiKey,
    suggestEnvVars: true,
}) }}

{{ forms.textField({
    label: 'Transform filesystem handle',
    instructions: 'Craft filesystem to store generated variants (e.g. your GCS bucket).',
    id: 'transformFsHandle',
    name: 'transformFsHandle',
    value: settings.transformFsHandle,
}) }}

{{ forms.textField({
    label: 'Perceptual target (SSIM)',
    instructions: 'Quality bar for lossy formats. 0.99 is perceptually lossless.',
    id: 'perceptualTarget',
    name: 'perceptualTarget',
    value: settings.perceptualTarget,
    size: 6,
}) }}

{{ forms.textField({
    label: 'Max source size (px)',
    id: 'maxSize',
    name: 'maxSize',
    value: settings.maxSize,
    size: 6,
}) }}

<hr>

<h2>On-upload source optimization (Pro)</h2>

{{ forms.lightswitchField({
    label: 'Optimize originals on upload',
    instructions: 'Cap + perceptually compress the stored original on upload/replace, keeping its format. Destructive — the original is rewritten — so leave the backup toggle on. Pro only; off by default.',
    id: 'onUploadOptimize',
    name: 'onUploadOptimize',
    on: settings.onUploadOptimize,
}) }}

{{ forms.lightswitchField({
    label: 'Keep a backup of the pristine original',
    instructions: 'Copies the untouched upload to the backup filesystem (or `storage/lithocinch/originals/`) before optimizing. If the backup cannot be secured, the optimization is skipped. Strongly recommended.',
    id: 'onUploadKeepBackup',
    name: 'onUploadKeepBackup',
    on: settings.onUploadKeepBackup,
}) }}

{{ forms.textField({
    label: 'On-upload max dimension (px)',
    instructions: 'Cap for the stored original — deliberately separate from (and more generous than) the delivery cap above.',
    id: 'onUploadMaxSize',
    name: 'onUploadMaxSize',
    value: settings.onUploadMaxSize,
    size: 6,
}) }}

{{ forms.textField({
    label: 'Backup filesystem handle',
    instructions: 'Craft filesystem for pristine-original backups (e.g. a cold-storage bucket). Blank = local `storage/lithocinch/originals/` on the web server.',
    id: 'onUploadBackupFsHandle',
    name: 'onUploadBackupFsHandle',
    value: settings.onUploadBackupFsHandle,
}) }}

{{ forms.textField({
    label: 'Savings log retention (days)',
    instructions: 'How long the Savings dashboard keeps detail activity rows before Craft\'s garbage collection prunes them. The lifetime "bytes saved" totals are never pruned — this only bounds the detail ledger. 0 = keep forever.',
    id: 'savingsLogRetentionDays',
    name: 'savingsLogRetentionDays',
    value: settings.savingsLogRetentionDays,
    size: 6,
}) }}
