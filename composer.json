{
    "name": "iceboxind/craft-crisp",
    "description": "Perceptually-lossless, content-aware image optimization and best-format delivery for Craft CMS, powered by the process-images (sharp) engine.",
    "version": "0.1.0",
    "type": "craft-plugin",
    "license": "proprietary",
    "support": {
        "docs": "https://github.com/iceboxind/craft-crisp"
    },
    "require": {
        "php": ">=8.0.2",
        "craftcms/cms": "^4.5.0 || ^5.0.0",
        "symfony/process": "^6.0 || ^7.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "iceboxind\\crisp\\": "src/"
        }
    },
    "extra": {
        "handle": "crisp",
        "name": "Crisp",
        "developer": "Dan Gaidula / Icebox Industries",
        "class": "iceboxind\\crisp\\Plugin"
    }
}
