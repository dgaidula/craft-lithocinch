{
    "name": "iceboxind/craft-lithocinch",
    "description": "Perceptually-lossless, content-aware image optimization and best-format delivery for Craft CMS, powered by the Lithocinch (sharp) engine.",
    "version": "0.1.0",
    "type": "craft-plugin",
    "license": "Apache-2.0",
    "support": {
        "docs": "https://github.com/dgaidula/craft-lithocinch"
    },
    "require": {
        "php": ">=8.0.2",
        "craftcms/cms": "^4.5.0 || ^5.0.0",
        "symfony/process": "^6.0 || ^7.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "iceboxind\\lithocinch\\": "src/"
        }
    },
    "extra": {
        "handle": "litho",
        "name": "Lithocinch",
        "developer": "Dan Gaidula / Icebox Industries",
        "class": "iceboxind\\lithocinch\\Plugin"
    }
}
